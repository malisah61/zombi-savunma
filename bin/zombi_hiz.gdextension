[configuration]

entry_symbol = "zombi_hiz_init"
compatibility_minimum = "4.3"

[libraries]

android.debug.arm64 = "res://bin/libzombihiz.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libzombihiz.android.template_release.arm64.so"
linux.debug.x86_64 = "res://bin/libzombihiz.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libzombihiz.linux.template_release.x86_64.so"
